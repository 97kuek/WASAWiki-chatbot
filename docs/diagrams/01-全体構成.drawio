          <mxGeometry x="620" y="120" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wiki" value="WASA Wiki（MediaWiki）&lt;br&gt;&lt;b&gt;認証の中継先&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="215" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="firestore" value="Firestore&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;利用回数 / 履歴30件 /&lt;br&gt;共有アシスタント / フィードバック&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
