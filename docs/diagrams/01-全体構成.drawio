          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="上＝質問に答えるときの経路。下＝資料を取り込むときの経路。&lt;b&gt;取り込みは自動化していない。&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="sec1" value="① 質問に答えるとき（本番・クラウド）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="部員のブラウザ&lt;br&gt;（PC / スマホ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="Cloudflare Pages&lt;br&gt;&lt;b&gt;React SPA&lt;/b&gt;（web/）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="run" value="Cloud Run（東京）&lt;br&gt;&lt;b&gt;Go API&lt;/b&gt;（backend/）&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;min-instances=0 / max=1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="270" width="200" height="90" as="geometry" />
