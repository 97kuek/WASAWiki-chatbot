<mxfile host="app.diagrams.net" agent="WASA Chat" version="24.0.0">
  <diagram name="RAGの仕組み" id="wasa-rag">
    <mxGraphModel dx="1240" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="RAGの仕組み ― どう切って、どう選んで、どう答えるか" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="上＝あらかじめ索引を作る工程（手元・Python）。下＝質問が来てから答えるまでの工程（本番・Go）。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="secA" value="A. 索引を作る（build_index.py / build_toc.py）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#6A4A8C;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="Wiki / 公式サイト / FEE&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;dump/pages.jsonl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;① 個人情報のマスキング&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;wikitextをパースする&lt;b&gt;前&lt;/b&gt;に行う&lt;br&gt;生年月日と個人メールだけを伏せ、&lt;br&gt;業務の申請先アドレスは&lt;b&gt;残す&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="125" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;② wikitextを整形&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;節の見出し・本文・リンクへ分解&lt;br&gt;20字未満だけを空として除外&lt;br&gt;（短い＝価値なし、ではない）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="125" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;③ チャンク化（検索の単位）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;目標 1,200字 / 最大 2,500字&lt;br&gt;&lt;b&gt;最上位見出しをまたがない&lt;/b&gt;&lt;br&gt;末尾が200字未満なら直前へ吸収&lt;br&gt;パンくず＝全節の共通接頭辞&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="118" width="215" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;④ メタデータを付ける&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;区分（班）: TEAM_RULES が正本&lt;br&gt;年代: N代 = 1984 + N年大会&lt;br&gt;出所: wiki / site&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1015" y="125" width="185" height="70" as="geometry" />
        </mxCell>

        <mxCell id="idx" value="&lt;b&gt;data/index.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;646ページ / 1,012チャンク / 735,264字&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="245" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="toc" value="&lt;b&gt;data/toc.md（目次）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;ページ名 + パンくず + リード文&lt;br&gt;先頭に facts.md を埋め込む&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1015" y="245" width="185" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="idx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="toc"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="divider" value="" style="line;strokeWidth=1;html=1;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="1160" height="10" as="geometry" />
        </mxCell>

        <mxCell id="secB" value="B. 質問に答える（backend/internal/pipeline）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4B7A3B;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="q" value="質問&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;+ 直近2往復 + 画像1枚（任意）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;⑤ ページを選ぶ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;目次（toc.md）&lt;/b&gt;をLLMへ渡し、&lt;br&gt;候補を最大4件もらう&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="255" y="475" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p1b" value="&lt;b&gt;コード側の決定的な候補（最大2件）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;合流の順は &lt;b&gt;実在タイトル → 型番 → リンク&lt;/b&gt;&lt;br&gt;・型番は大小文字とハイフンの差を無視（TR797＝TR-797）&lt;br&gt;・0件なら文字bigramで保険検索&lt;br&gt;・&lt;b&gt;index.Resolve&lt;/b&gt; で実在タイトルだけに解決し、架空名を落とす&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ee;strokeColor=#82b366;fontSize=12;align=left;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="590" width="365" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="&lt;b&gt;⑥ 節を選ぶ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;12,000字以内なら&lt;b&gt;全節をそのまま渡す&lt;/b&gt;&lt;br&gt;超えるときだけLLMで最大8節へ絞る&lt;br&gt;返ってきたIDは実在するものだけ受け付ける&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="&lt;b&gt;⑦ 回答を作る&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;選んだ本文 + 会話の文脈&lt;br&gt;+ アシスタントの口調規則&lt;br&gt;→ Gemini&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="785" y="470" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="&lt;b&gt;⑧ 画面へ返す（SSE）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pages → delta → done&lt;br&gt;出典カードが先、本文は少しずつ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="470" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="src" value="&lt;b&gt;出典は索引からサーバーが組み立てる&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;モデルの文章から抜き出さない。&lt;br&gt;抜き出す形にすると「引き継ぎWiki」のような&lt;br&gt;&lt;b&gt;実在しない出典名を作れてしまう&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="785" y="600" width="415" height="75" as="geometry" />
        </mxCell>

        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb5" value="合流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1b" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B8860B;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eidx" value="本文を読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#B8860B;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="idx" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etoc" value="目次を渡す" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#B8860B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="toc" target="p1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="640" y="280" /><mxPoint x="640" y="420" /><mxPoint x="355" y="420" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="scopenote" value="&lt;b&gt;アシスタントの参照範囲は、コードが落とす。&lt;/b&gt;&lt;br&gt;ページ選択・実在タイトル候補・保険検索・型番検索の&lt;b&gt;すべての経路で&lt;/b&gt;範囲外を除外する。&lt;br&gt;どれか1つでも漏れると範囲指定が意味を失うため。範囲は&lt;b&gt;狭める指定だけ&lt;/b&gt;で、広げる指定は持てない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="whynote" value="&lt;b&gt;なぜベクトル検索ではなく「目次を読ませる」のか&lt;/b&gt;&lt;br&gt;目次方式のページ選択は、BM25のベースラインを&lt;b&gt;24ポイント上回った&lt;/b&gt;（M2a）。&lt;br&gt;評価は&lt;b&gt;チャンク単位&lt;/b&gt;で行う。ページ単位のRecallは実力を17ポイント過大評価する。" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacing=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="650" y="720" width="550" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
