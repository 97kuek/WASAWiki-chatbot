# このファイルは「見本」です。ここには絶対に実際の値を書かないでください。
# コピーしてできた .env のほうに書きます（.env だけが .gitignore 対象です）。
#   cp .env.example .env

WIKI_API=https://wasabirdman.sakura.ne.jp/wbwiki/w/api.php

# Wiki取得と実Wikiに対する認証テストで使います。
# 普段WASA Wikiにログインしている通常アカウントを設定し、値は絶対にコミットしません。
WIKI_USER=
WIKI_PASS=

# 管理画面からの更新確認専用。Cloud Runでは個人アカウントではなく、
# 読み取りだけに使う専用WikiアカウントをSecret Managerから設定します。
# ローカルで空欄なら、上のWIKI_USER / WIKI_PASSを使います。
WIKI_UPDATE_USER=
WIKI_UPDATE_PASS=

# Cookieの署名とFirestore上の利用者識別に使う固定鍵。変更すると既存履歴を参照できなくなります。
# 例: openssl rand -base64 32
SESSION_SECRET=
DAILY_LIMIT=30
# 本番で利用回数とチャット履歴を端末間同期するGoogle Cloudプロジェクト。
# 未設定のローカル開発ではメモリ保存になり、再起動時に消えます。
FIRESTORE_PROJECT_ID=
# Cloudflare PagesからAPIを呼ぶ本番環境では、そのフロントURLを設定します。
# 複数ある場合はカンマ区切りにします。ローカルではlocalhostと127.0.0.1を同一扱いにします。
ALLOW_ORIGIN=

# ---- LLMプロバイダ ----
# ollama（既定・ローカル） / gemini / compat（OpenAI互換: Grok, Groq, Mistral など）
LLM_PROVIDER=ollama

# GeminiはWASAで1つのGoogle CloudプロジェクトとAPIキーをサーバー側だけで管理します。
# 既定モデル。省略時は本番向けの固定ID gemini-3.5-flash-lite を使います。
# latest別名は中身が予告なく変わるため、本番では固定IDを使います。
GEMINI_API_KEY=
GEMINI_MODEL=
# 回答モード別のモデル。空欄ならすべてGEMINI_MODELへ戻るため、比較測定で
# 改善を確認するまでは空欄のままにします。ブラウザからモデルIDは指定できません。
GEMINI_FAST_MODEL=
GEMINI_STANDARD_MODEL=
GEMINI_DEEP_MODEL=
# 有料枠を確認した場合だけtrueにします。
GEMINI_PAID_TIER=false
# 無料枠へ非公開Wikiを送ることを組織として承認した場合だけtrueにします。
# WASAでは2026-08-08の会議で代表・PMが承認しました。
GEMINI_FREE_TIER_APPROVED=false
# 無料枠のRPM制限へ余裕を持たせる。Goバックエンド全体でこの秒数以上を空ける。
GEMINI_MIN_INTERVAL=4
# 短時間の429 / 503 / 一時的な通信失敗で追加試行する回数（初回を含めると最大3回）。
# 日次上限の429は待っても回復しないため再試行しません。
GEMINI_MAX_RETRIES=2
# 管理画面の残量推定に使う、現在のプロジェクト・モデルの日次リクエスト上限。
# Google側の上限を変更したときだけ合わせて変更します。
GEMINI_RPD_LIMIT=500

# フロントのプロフィールメニューから開くWiki。通常は変更不要。
VITE_WIKI_URL=https://wasabirdman.sakura.ne.jp/wbwiki/w/index.php

# OpenAI互換APIを使う場合
#   xAI Grok  : https://api.x.ai/v1
#   Groq      : https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 共同管理者を追加・解除し、管理画面を利用できる主管理者のWiki利用者名（カンマ区切り）。
# 利用者名に空白が入るため、区切りはカンマにしています。
# 共有アカウントは使わず、管理者本人のWiki利用者名を設定します。
# この主管理者は画面から外せません。共同管理者は管理画面から追加します。
# 未設定でも動きますが、管理画面へ入れず、作成者本人しか削除できなくなります。
# 先頭の1人が、assistants/ の初期アシスタントの作成者になります。
ADMIN_USERS=

# ---- フィードバックのメール通知 ----
# FEEDBACK_EMAIL_TOは通知を受け取る管理者のメールアドレスです（複数ならカンマ区切り）。
# SMTPは、メール送信サービスへメールを渡すための通信方法です。
# Gmail / Google Workspaceなら SMTP_HOST=smtp.gmail.com、SMTP_PORT=587 を使い、
# SMTP_PASSWORDには通常のログインパスワードではなくアプリパスワードを設定します。
# 実際のアドレスやパスワードは、この見本ではなく.envまたはSecret Managerへ置きます。
FEEDBACK_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 初期アシスタント（assistants/*.json）の置き場所。通常は変更不要。
# 同じIDが既に登録されていれば上書きしません。
ASSISTANT_SEED_DIR=assistants
